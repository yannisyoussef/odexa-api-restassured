# Reference only: Gradle does NOT load this file. Export environment variables in your shell/CI.
# Never commit .env, passwords, client secrets or tokens. Never pass secrets with -D or CLI flags.
# LOCAL defaults below target the documented gateway and development OIDC password grant.
# Optional bridge: python3 scripts/run-local.py --odexa-dir /path/to/existing/odexa
# It reads ONLY LOCAL_FIXTURE_PASSWORD from that target's .env; it never starts/stops the target.
ODEXA_ENV=local
ODEXA_VERSION=v0.1.0
ODEXA_BASE_URL=http://localhost:8080
ODEXA_TOKEN_URL=http://localhost:8180/realms/odexa/protocol/openid-connect/token
ODEXA_CLIENT_ID=odexa-cli
ODEXA_CLIENT_SECRET=
ODEXA_FIXTURE_PASSWORD=

# Only these four actors are provisioned by v0.1.0. Per-actor passwords override LOCAL fallback.
ODEXA_CUSTOMER_A_USERNAME=customer-a
ODEXA_CUSTOMER_A_PASSWORD=
ODEXA_CUSTOMER_B_USERNAME=customer-b
ODEXA_CUSTOMER_B_PASSWORD=
ODEXA_OTHER_CUSTOMER_A_USERNAME=customer-other-a
ODEXA_OTHER_CUSTOMER_A_PASSWORD=
ODEXA_MERCHANT_A_USERNAME=merchant-a
ODEXA_MERCHANT_A_PASSWORD=

ODEXA_PRODUCT_ID=11111111-1111-4111-8111-111111111111
ODEXA_OTHER_PRODUCT_ID=22222222-2222-4222-8222-222222222222
ODEXA_TENANT_A=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
ODEXA_TENANT_B=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
ODEXA_TIMEOUT_SECONDS=10
ODEXA_POLL_TIMEOUT_SECONDS=90
ODEXA_POLL_INTERVAL_MILLIS=250
ODEXA_VERBOSE=false

# BOTH must be true for mutation tests. Only use dedicated, exclusively owned fixture stock.
# Existing target bridge requires explicit --allow-mutation --exclusive-fixtures instead.
ODEXA_ALLOW_MUTATION=false
ODEXA_EXCLUSIVE_FIXTURES=false

# REMOTE: run ./gradlew --no-configuration-cache apiTest directly; NO product directory needed.
# Set ODEXA_ENV=remote and explicitly supply ALL endpoint/client/actor/fixture/tenant fields above.
# Use real HTTPS base/token URLs without userinfo/query/fragment. No insecure TLS or redirects.
# Supply each actor's password via environment; ODEXA_FIXTURE_PASSWORD is LOCAL only.
# ODEXA_CLIENT_SECRET remains optional, according to the hosted OIDC client's configuration.
# Keep mutation flags false unless the remote environment's owner grants exclusive fixtures.
# REMOTE is never run automatically by this repository's CI.
